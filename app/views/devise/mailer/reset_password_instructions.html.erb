<h1  class="title" style=" margin-bottom: 5px !important;"><%= t("mailer.reset_password.title") %></h1>
<div class="background-p subtitle">
  <%= @email %>
</div>
<div class="section-gap">
  <%= t("mailer.reset_password.description") %>
</div>

<div class="section-gap">
  <%= link_to t("mailer.reset_password.button"),
    edit_password_url(
      @resource,
      reset_password_token: @token,
      **mailer.tenant_url_options_for(@resource)
    ),
    target: "_blank",
    class: "primary-button"
    %>
</div>
<div class="section-gap">
  <%= t("mailer.confirmation.no_preview",
    url: link_to(edit_password_url(@resource, reset_password_token: @token,
        **mailer.tenant_url_options_for(@resource)),
        edit_password_url(@resource, reset_password_token: @token, **mailer.tenant_url_options_for(@resource)),
        target: "_blank")).html_safe %>
</div>

<div class="section-gap" style="text-align: center; margin-top: -20px;">
  <%= t("mailer.reset_password.ignore") %>
  <%= t("mailer.reset_password.password_not_changed") %>
</div>

