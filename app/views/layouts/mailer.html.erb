<!DOCTYPE html>
<html>
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <style>
      body {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        font-family: Roboto, Arial, Helvetica, sans-serif;
      }
      .container {
        max-width: 600px;
        width: 100%;
        font-family: Roboto, Arial, Helvetica, sans-serif;
      }
      .logo {
        width: 100%;
        height: auto;
        max-height: 230px;
        overflow: hidden;
        margin-bottom: 20px;
      }
      .logo img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
      }
      .title{
        font-size: 32px;
        font-weight: 500;
      }
      .subtitle{
        font-size: 20px;
        font-weight: 400;
        color: white;
      }
      .background-p{
        background-color: #e2e8f0;
        padding: 20px;
        width: fit-content;
        color: #99a1af;
        font-weight: 400;
      }
      .section-gap{
        padding-top: 20px;
        padding-bottom: 20px;
      }
      .primary-button{
        background-color: #8200db;
        padding: 20px;
        width: fit-content;
        color: white;
        font-weight: 400;
        text-decoration: none;
      }
        a {
          color: #8200db;
          text-decoration: none;
        }
    </style>
  </head>
  <body>
  <div class="container">
    <div class="logo">
      <%= image_tag attachments['banner.png'].url, alt: "Banner" %>
    </div>
    <div class="section">
    <%= yield %>
    </div>
  </div>
  </body>
</html>
